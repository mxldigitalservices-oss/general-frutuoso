<%- include('partials/head', { title: item.titulo, desc: item.resumen, ogImagen: item.imagen }) %>
<%- include('partials/header') %>
<main id="contenido">
<article class="section"><div class="wrap narrow">
  <p class="eyebrow"><a href="/noticias">← Noticias y artículos</a></p>
  <p class="meta"><span class="badge"><%= item.tipo === 'articulo' ? 'Artículo' : 'Noticia' %></span> <%= fmtFecha(item.fecha) %></p>
  <h1><%= item.titulo %></h1>
  <p class="lead"><%= item.resumen %></p>
  <% if (item.imagen) { %><img class="art-img" src="<%= item.imagen %>" alt=""><% } %>
  <% if (item.videoYoutubeId) { %><%- include('partials/cubrefalta', { id: item.videoYoutubeId, titulo: item.titulo }) %><% } %>
  <div class="prose"><% parrafos(item.contenido).forEach(p => { %><p><%= p %></p><% }) %></div>
  <% if (item.enlace) { %><p><a class="btn btn-ghost" href="<%= item.enlace %>" target="_blank" rel="noopener noreferrer"><%= item.enlaceTexto || 'Leer más' %></a></p><% } %>
</div></article>
</main>
<%- include('partials/footer') %>
