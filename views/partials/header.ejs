<% const on = (p) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'on' : ''; %>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">FH</span>
      <span class="brand-text"><strong><%= site.nombre %></strong><small><%= ajustes.textos.heroEyebrow %></small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Abrir o cerrar el menú">
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav" aria-label="Principal">
      <a class="<%= on('/') %>" href="/">Inicio</a>
      <a class="<%= on('/biografia') %>" href="/biografia">Biografía</a>
      <a class="<%= on('/libros') %>" href="/libros">Libros</a>
      <a class="<%= on('/rincon-del-general') %>" href="/rincon-del-general"><%= ajustes.textos.tituloRincon %></a>
      <a class="<%= on('/noticias') %>" href="/noticias">Noticias</a>
      <% if (ajustes.interruptores.eventos) { %><a class="<%= on('/eventos') %>" href="/eventos">Eventos</a><% } %>
      <% if (ajustes.interruptores.enVivo) { %><a class="nav-vivo <%= on('/en-vivo') %>" href="/en-vivo"><span class="dot" aria-hidden="true"></span>En vivo</a><% } %>
      <a class="<%= on('/contacto') %>" href="/contacto">Contacto</a>
    </nav>
  </div>
</header>
