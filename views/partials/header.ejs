<% const on = (p) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'on' : ''; %>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">FH</span>
      <span class="brand-text"><strong><%= site.nombre %></strong><small><%= ajustes.textos.heroEyebrow %></small></span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Abrir o cerrar el menú">
    <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
    <nav class="nav" aria-label="Principal">
      <a class="<%= on('/') %>" href="/"><%= ajustes.menu.inicio %></a>
      <a class="<%= on('/biografia') %>" href="/biografia"><%= ajustes.menu.biografia %></a>
      <a class="<%= on('/libros') %>" href="/libros"><%= ajustes.menu.libros %></a>
      <a class="<%= on('/rincon-del-general') %>" href="/rincon-del-general"><%= ajustes.menu.rincon %></a>
      <a class="<%= on('/noticias') %>" href="/noticias"><%= ajustes.menu.noticias %></a>
      <% if (hayPrensa) { %><a class="<%= on('/prensa') %>" href="/prensa"><%= ajustes.menu.prensa %></a><% } %>
      <% if (ajustes.interruptores.eventos) { %><a class="<%= on('/eventos') %>" href="/eventos"><%= ajustes.menu.eventos %></a><% } %>
      <% if (ajustes.interruptores.enVivo) { %><a class="nav-vivo <%= on('/en-vivo') %>" href="/en-vivo"><span class="dot" aria-hidden="true"></span><%= ajustes.menu.enVivo %></a><% } %>
      <a class="<%= on('/contacto') %>" href="/contacto"><%= ajustes.menu.contacto %></a>
    </nav>
  </div>
</header>
