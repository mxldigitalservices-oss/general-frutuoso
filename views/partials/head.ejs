<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title ? title + ' · ' : '' %><%= site.nombre %></title>
<meta name="description" content="<%= locals.desc || 'Portal oficial de Juan Manuel Fructuoso Heredia: General (r), abogado y escritor. Libros, biografía, noticias y eventos.' %>">
<link rel="canonical" href="<%= site.url %><%= path %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= locals.title ? title + ' · ' : '' %><%= site.nombre %>">
<meta property="og:description" content="<%= locals.desc || 'Portal oficial de Juan Manuel Fructuoso Heredia.' %>">
<% if (locals.ogImagen) { %><meta property="og:image" content="<%= site.url %><%= ogImagen %>"><% } %>
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<% if (fuentesUrl) { %><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="<%= fuentesUrl %>"><% } %>
<style><%- temaCss %></style>
<link rel="stylesheet" href="/css/main.css?v=<%= build %>">
</head>
