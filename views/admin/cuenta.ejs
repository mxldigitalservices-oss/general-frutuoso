<%- include('partials/top') %>
<div class="a-head"><h1>Mi cuenta</h1></div>
<%- include('partials/avisos') %>
<p class="a-muted">Aquí defines tu propio correo y contraseña de acceso. Para cualquier cambio debes confirmar tu contraseña actual.</p>
<form method="post" action="/admin/cuenta" class="a-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="a-field"><label for="nombre">Nombre</label><input id="nombre" type="text" name="nombre" required maxlength="120" value="<%= valores.nombre %>"></div>
  <div class="a-field"><label for="email">Correo de acceso</label><input id="email" type="email" name="email" required maxlength="160" value="<%= valores.email %>" autocomplete="username"></div>
  <div class="a-field"><label for="claveNueva">Nueva contraseña (déjalo vacío para no cambiarla)</label><input id="claveNueva" type="password" name="claveNueva" minlength="10" maxlength="72" autocomplete="new-password"><small>Mínimo 10 caracteres. Usa una frase larga que solo tú conozcas.</small></div>
  <div class="a-field"><label for="claveNueva2">Repite la nueva contraseña</label><input id="claveNueva2" type="password" name="claveNueva2" minlength="10" maxlength="72" autocomplete="new-password"></div>
  <div class="a-field"><label for="claveActual">Contraseña actual (obligatoria para guardar) *</label><input id="claveActual" type="password" name="claveActual" required autocomplete="current-password"></div>
  <div class="a-bar"><button class="a-btn" type="submit">Guardar cambios</button></div>
</form>
<%- include('partials/bottom') %>
