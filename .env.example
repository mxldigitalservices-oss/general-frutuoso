# ───────── Servidor ─────────
NODE_ENV=development
PORT=8080
# Genera uno largo con: openssl rand -hex 32
SESSION_SECRET=
# En Railway (HTTPS) déjalo en true (o sin definir). Para probar por http://localhost pon false
COOKIE_SECURE=false

# ───────── Dominio oficial ─────────
# Sitio público y panel /admin viven juntos bajo el mismo dominio (www redirige al dominio sin www).
# En Railway ya están definidas. Si faltan en producción, se usa juanmanuelfructuosoheredia.com.
PUBLIC_URL=https://juanmanuelfructuosoheredia.com
CANONICAL_HOST=juanmanuelfructuosoheredia.com
# Proxies delante de la app (Railway = 1)
# TRUST_PROXY=1
# (SITE_URL sigue aceptándose como nombre anterior de PUBLIC_URL)

# ───────── Primer acceso al panel ─────────
# Código de un solo uso para crear la cuenta del General en /admin/setup.
# Después de crear la cuenta puedes borrar esta variable.
# Genera uno con: openssl rand -hex 16
SETUP_TOKEN=

# ───────── Bases de datos (Railway las inyecta con estos nombres) ─────────
DATABASE_URL=postgresql://usuario:clave@localhost:5432/fructuoso
MONGO_URL=mongodb://localhost:27017/fructuoso
REDIS_URL=redis://localhost:6379
# PG_SSL=true

# ───────── Correo de contacto (opcional, Gmail con clave de aplicación) ─────────
GMAIL_USER=
GMAIL_PASS=
CONTACT_TO=
WHATSAPP=18093041128
