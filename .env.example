# ───────── Servidor ─────────
NODE_ENV=development
PORT=8080
# Genera uno largo con: openssl rand -hex 32
SESSION_SECRET=
# En Railway (HTTPS) déjalo en true. Para probar por http://localhost pon false
COOKIE_SECURE=false

# ───────── Dominio oficial (cuando lo conectes) ─────────
# SITE_URL=https://www.tudominio.com
# CANONICAL_HOST=www.tudominio.com

# ───────── Primer acceso al panel ─────────
# Código de un solo uso para crear la cuenta del General en /admin/setup.
# Después de crear la cuenta puedes borrar esta variable.
# Genera uno con: openssl rand -hex 16
SETUP_TOKEN=

# ───────── Bases de datos (Railway las inyecta con estos nombres) ─────────
DATABASE_URL=postgresql://usuario:clave@localhost:5432/fructuoso
MONGO_URL=mongodb://localhost:27017/fructuoso
REDIS_URL=redis://localhost:6379
# PG_SSL=true

# ───────── Correo de contacto (opcional, Gmail con clave de aplicación) ─────────
GMAIL_USER=
GMAIL_PASS=
CONTACT_TO=
WHATSAPP=18093041128
